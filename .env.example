# Nutre-Fit-Dia — Vite Environment Variables
# Copy this file to .env and adjust values for your deployment.

# localStorage key prefix (all stores use: {prefix}-{store-name})
VITE_STORAGE_PREFIX=nutrefitdia

# Vite base URL: "/" for root deploy, "/repo-name/" for GitHub Pages
VITE_BASE_URL=/nutre-fit-dia/

# Log level: debug | info | warn | error
VITE_LOG_LEVEL=info
